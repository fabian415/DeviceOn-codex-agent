# 複製這個檔案為 .env 並填入實際值，.env 不進版控。
AZURE_DEVOPS_PAT=<your-azure-devops-pat>
AZURE_DEVOPS_ORG=https://dev.azure.com/wise-deviceon
# 值含空白時必須加引號，例如 AZURE_DEVOPS_PROJECT="DeviceOn Core"
AZURE_DEVOPS_PROJECT=Sandbox
AZURE_DEVOPS_REPO=fabianTest2_Frontend
MAIN_BRANCH=master
AZURE_PIPELINE_NAME=fabianTest2_Frontend
